---
import { css } from "../../styled-system/css";

interface Props {
  language: string;
}

const { language } = Astro.props;

const styles = css({
  position: "absolute",
  top: "4",
  right: "4",
  bg: "black",
  fontWeight: "medium",
  color: "gray.100",
  borderRadius: "md",
  px: "2",
  pt: "2",
  pb: "2",
  fontSize: "sm",
  lineHeight: "none",
});
---

<div class={styles}>{language}</div>
