---
import LanguageBadge from "./LanguageBadge.astro";
import { css } from "../../styled-system/css";
import { Image } from "astro:assets";

interface Props {
  kebabCaseTitle: string;
  language: string;
  title: string;
}

const { kebabCaseTitle, language, title } = Astro.props;

const linkStyles = css({
  d: "block",
});

const cardStyles = css({
  pos: "relative",
  userSelect: "none",
  bg: "gray.200",
  rounded: "xl",
  color: "gray.700",
  transition: "transform 0.2s ease-in-out",
  transform: "translateZ(0)",
  _hover: {
    transform: "scale(1.02)",
  },
});

const imageStyles = css({
  roundedTop: "lg",
  w: "100%",
});

const titleStyles = css({
  p: "5",
  fontWeight: "bold",
});
---

<a class={linkStyles} href={`/${kebabCaseTitle}`}>
  <div class={cardStyles}>
    <Image
      class={imageStyles}
      alt="Project banner, decorative only"
      src={`/${kebabCaseTitle}.png`}
      width={400}
      height={300}
    />
    <p class={titleStyles}>{title}</p>
    <LanguageBadge language={language} />
  </div>
</a>
