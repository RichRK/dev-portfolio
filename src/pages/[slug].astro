---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import projectsData from "../data/projects.json";
import { kebabCase } from "../utils/kebabCase";
import type { Project } from "../types/Project";
import { css } from "../../styled-system/css";
import { Image } from "astro:assets";

export function getStaticPaths() {
  const projects = projectsData as Project[];

  return projects.map((project) => {
    return {
      params: { slug: kebabCase(project.title) },
      props: { project },
    };
  });
}

const {
  project: { repo, title, writeup },
} = Astro.props;

const writeupExists = writeup && writeup.length > 0;
const kebabTitle = kebabCase(title);
const imagePath = `/${kebabTitle}.png`;

const pageContainerStyles = css({
  minH: "screen",
  bg: "gray.900",
  fontFamily: "sans",
  fontWeight: "light",
  fontSize: "lg",
  color: "gray.100",
  pt: { base: "10", md: "12", lg: "14" },
  pb: "20",
  px: "8",
});

const contentContainerStyles = css({
  display: "flex",
  flexDirection: "column",
  maxW: "2xl",
  mx: "auto",
  insetX: "0",
});

const headingStyles = css({
  fontWeight: "bold",
  fontSize: "5xl",
  lineHeight: "tight",
  mb: "10",
});

const imageStyles = css({
  mb: "10",
  borderRadius: "lg",
  width: "full",
});

const writeupContainerStyles = css({ maxW: "none" });

const subheadingStyles = css({
  fontWeight: "medium",
  fontSize: "2xl",
  mt: "4",
  mb: "10",
});

const paragraphStyles = css({ mb: "6" });

const listStyles = css({
  listStyleType: "disc",
  pl: "5",
});

const listItemStyles = css({
  mb: "8",
  pl: "1",
});
---

<Layout title={title}>
  <div class={pageContainerStyles}>
    <div class={contentContainerStyles}>
      <h1 class={headingStyles}>
        {title}
      </h1>
      <Image
        alt="Illustrative icon"
        class={imageStyles}
        src={imagePath}
        width={800}
        height={600}
      />
      <Button icon="/github.png" url={repo}>Visit repo</Button>
      {
        writeupExists ? (
          <div class={writeupContainerStyles}>
            {writeup.map((item) => {
              if (item.type === "heading") {
                return <h2 class={subheadingStyles}>{item.content}</h2>;
              }

              if (item.type === "paragraphs") {
                return item.content.map((paragraph) => {
                  return <p class={paragraphStyles}>{paragraph}</p>;
                });
              }

              if (item.type === "bullets") {
                return (
                  <ul class={listStyles}>
                    {item.content.map((bullet) => {
                      return <li class={listItemStyles}>{bullet}</li>;
                    })}
                  </ul>
                );
              }

              return null;
            })}
          </div>
        ) : (
          <p>
            I haven't got around to writing this project up just yet! Check back
            soon. 👀
          </p>
        )
      }
    </div>
  </div>
</Layout>

<style>
  /* Add any page-specific styles here */
</style>
