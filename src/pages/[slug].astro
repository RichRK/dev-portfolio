---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button';
import projectsData from '../data/projects.json';
import { kebabCase } from '../utils/kebabCase';
import type { Project } from '../types/Project';

export function getStaticPaths() {
  const projects = projectsData as Project[];

  return projects.map((project) => {
    return {
      params: { slug: kebabCase(project.title) },
      props: { project }
    };
  });
}

const { project: { repo, title, writeup } } = Astro.props;

const writeupExists = writeup && writeup.length > 0;
const kebabTitle = kebabCase(title);
const imagePath = `/${kebabTitle}.png`;
---

<Layout title={title}>
  <div class="min-h-screen bg-gray-900 font-sans font-light text-lg text-gray-100 pt-10 md:pt-12 lg:pt-14 pb-20 px-8">
    <div class="grid grid-cols-1 gap-8 max-w-2xl mx-auto inset-x-0">
      <h1 class="font-bold text-5xl leading-tight mb-2">
        {title}
      </h1>
      <img alt="" class="mb-3 rounded-lg w-full" src={imagePath} />
      <Button icon="/github.png" url={repo}>Visit repo</Button>
      {
        writeupExists && (
          <div class="max-w-none">
            {writeup.map(item => {
              if (item.type === "heading") {
                return <h2 class="font-medium text-2xl">{item.content}</h2>;
              }

              if (item.type === "paragraphs") {
                return item.content.map((paragraph) => {
                  return <p class="col-start-1 col-span-full">{paragraph}</p>;
                });
              }
                
              if (item.type === "bullets") {
                return <ul class="list-disc pl-5">
                  {item.content.map((bullet) => {
                    return <li class="mb-8 last:mb-0 pl-1">{bullet}</li>;
                  })}
                </ul>;
              }
              
              return null;
            })}
          </div>
        )
      }
      {
        !writeupExists && (
          <p>I haven't got around to writing this project up just yet! Check back soon. 👀</p>
        )
      }
    </div>
  </div>
</Layout>

<style>
  /* Add any page-specific styles here */
</style>
