---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import projectsData from "../data/projects.json";
import { kebabCase } from "../utils/kebabCase";
import type { Project } from "../types/Project";
import { css } from "../../styled-system/css";

const projects = projectsData as Project[];

const pageContainerStyles = css({
  minH: "screen",
  bg: "gray.900",
  fontFamily: "sans",
  fontWeight: "light",
  fontSize: "lg",
  color: "gray.100",
  pt: { base: "10", md: "12", lg: "14" },
  pb: "20",
  px: { base: "8", md: "4", lg: "10", xl: "16" },
});

const innerContainerStyles = css({
  px: { md: "4", lg: "10", xl: "16" },
});

const headingStyles = css({
  fontSize: "5xl",
  fontWeight: "bold",
  lineHeight: "tight",
  mb: { base: "6", lg: "8" },
});

const paragraphStyles = css({
  mb: { base: "10", lg: "12" },
  width: { sm: "2/3", lg: "1/2" },
});

const gridStyles = css({
  display: "grid",
  gridTemplateColumns: { base: "repeat(1, 1fr)", sm: "repeat(2, 1fr)" },
  gap: { base: "12", sm: "8", md: "10", lg: "14", xl: "16" },
});
---

<Layout title="Development Work">
  <div class={pageContainerStyles}>
    <div class={innerContainerStyles}>
      <h1 class={headingStyles}>Development work</h1>
      <p class={paragraphStyles}>
        A selection of projects I've worked on — some big and some small, all
        full of their own challenges.
      </p>
      <div class={gridStyles}>
        {
          projects.map(({ language, title }) => (
            <Card
              kebabCaseTitle={kebabCase(title)}
              language={language}
              title={title}
            />
          ))
        }
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Add any page-specific styles here */
</style>
