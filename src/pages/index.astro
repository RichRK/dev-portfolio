---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card';
import projectsData from '../data/projects.json';
import { kebabCase } from '../utils/kebabCase';

const projects = projectsData;
---

<Layout title="Development Work">
  <div class="min-h-screen bg-gray-900 font-sans font-light text-lg text-gray-100 pt-10 md:pt-12 lg:pt-14 pb-20 px-8 md:px-4 lg:px-10 xl:px-16">
    <div class="md:px-4 lg:px-10 xl:px-16">
      <h1 class="text-5xl font-bold leading-tight mb-6 lg:mb-8">
        Development work
      </h1>
      <p class="mb-10 lg:mb-12 sm:w-2/3 lg:w-1/2">
        A selection of projects I've worked on — some big and some small, all full of their own challenges.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-12 sm:gap-8 md:gap-10 lg:gap-14 xl:gap-16">
        {
          projects.map((project: any) => (
            <Card
              kebabCaseTitle={kebabCase(project.title)}
              language={project.language}
              title={project.title}
            />
          ))
        }
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Add any page-specific styles here */
</style>